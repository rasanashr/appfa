generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Artist {
  id              String   @id @default(cuid())
  name            String
  imageUrl        String   @default("/covers/artist-default.svg")
  bio             String   @default("")
  monthlyListeners Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  albums          Album[]
  tracks          Track[]
}

model Album {
  id          String   @id @default(cuid())
  title       String
  coverUrl    String   @default("/covers/album-default.svg")
  releaseYear Int      @default(2024)
  artistId    String
  artist      Artist   @relation(fields: [artistId], references: [id])
  tracks      Track[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Track {
  id        String   @id @default(cuid())
  title     String
  duration  Int      @default(0)
  audioUrl  String   @default("")
  coverUrl  String   @default("")
  albumId   String?
  album     Album?   @relation(fields: [albumId], references: [id])
  artistId  String
  artist    Artist   @relation(fields: [artistId], references: [id])
  playCount Int      @default(0)
  genre     String   @default("پاپ")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  playlists PlaylistTrack[]
  likes     Like[]
}

model Playlist {
  id          String           @id @default(cuid())
  title       String
  description String           @default("")
  coverUrl    String           @default("/covers/playlist-default.svg")
  isPublic    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tracks      PlaylistTrack[]
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id])
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id])
  order      Int      @default(0)
}

model Like {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  sessionId String
  createdAt DateTime @default(now())

  @@unique([trackId, sessionId])
}
